# ============================================================================
# 看不見的痛｜環境變數範本
# ============================================================================
# 此檔案僅含「範例值與說明」。
# 真實連線字串、密鑰、OAuth credentials 一律只放在 Vercel Environment Variables，
# 永不寫入此檔案或 commit 到 GitHub。
# ============================================================================

# ---------------------------------------------------------------------------
# 資料庫（Neon Postgres）
# ---------------------------------------------------------------------------
# 本機開發可用 SQLite 暫時測試；正式環境（含 Vercel Preview）必須用 Neon Postgres。
#
# 本機 SQLite（僅 dev 測試用，匿名分享 enum 在 sqlite 不支援，建議直接用 Neon dev branch）：
# DATABASE_URL="file:./db/custom.db"
#
# Neon Postgres（正式 / Preview）：
# 至 Vercel Dashboard → Storage → Connect Database → Neon → 建立後複製連線字串
# 範例格式：
# DATABASE_URL="postgresql://user:password@ep-xxx-xxx.region.aws.neon.tech/dbname?sslmode=require"
DATABASE_URL="file:./db/custom.db"

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) — 管理者登入
# ---------------------------------------------------------------------------
# AUTH_SECRET：JWT 簽章密鑰。產生方式：
#   openssl rand -base64 32
# 或：
#   bunx auth secret
# 此密鑰同時用於：
#   - NextAuth JWT session 簽章
#   - 投稿限流 cookie 簽章（見 src/lib/rate-limit.ts）
AUTH_SECRET=""

# Google OAuth credentials：
# 至 https://console.cloud.google.com/apis/credentials 建立 OAuth 2.0 Client ID
# Authorized redirect URI 必須包含：
#   http://localhost:3000/api/auth/callback/google  （本機開發）
#   https://<your-vercel-domain>/api/auth/callback/google  （正式）
#   https://<your-preview-domain>/api/auth/callback/google  （每個 preview）
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# 管理者 email allowlist（逗號分隔，大小寫不拘）：
# 只有列在此處的 Google 帳號才能登入 /admin/* 並審核投稿。
# 範例：
# ADMIN_EMAILS="crystal@example.com,editor@example.com"
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# 可選：網站公開 URL（用於 server-side fetch 與 redirect 驗證）
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL="https://your-domain.com"
